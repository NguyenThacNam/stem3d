# Chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# CSDL PostgreSQL
POSTGRES_DB=stem3d
POSTGRES_USER=stem3d
# Chỉ dùng chữ, số, "-" và "_" (mật khẩu được ghép vào DATABASE_URL).
POSTGRES_PASSWORD=doi-mat-khau-nay
# db không mở cổng ra ngoài. Nếu cần pgAdmin thì mở db ra cổng 5433 (xem docker-compose.override.yml),
# không dùng 5432 vì có thể trùng PostgreSQL cài sẵn trên máy.

# Cổng web (Nginx) trên máy: http://localhost:8080
WEB_PORT=8080

# Khóa ký JWT: chuỗi ngẫu nhiên dài (ví dụ: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=doi-chuoi-nay

# Mật khẩu chung cho các tài khoản mẫu do script seed tạo (chỉ máy phát triển, ít nhất 8 ký tự).
# Chạy: docker compose exec api python -m scripts.seed
SEED_PASSWORD=

# Môi trường: dev | prod (prod bật cookie Secure)
APP_ENV=dev
